generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  discordId String   @unique
  username  String
  dmOptOut  Boolean  @default(false)
  teams     Team[]   @relation("TeamOwner")
  createdAt DateTime @default(now())
}

enum TeamStatus {
  ACTIVE
  SUSPENDED
  DISBANDED
}

model Team {
  id            String                   @id @default(cuid())
  teamId        String                   @unique
  name          String
  tag           String                   @unique
  logo          String?
  region        String?
  email         String?
  phone         String?
  status        TeamStatus               @default(ACTIVE)
  roleId        String?
  ownerId       String
  owner         User                     @relation("TeamOwner", fields: [ownerId], references: [id])
  members       TeamMember[]
  registrations TournamentRegistration[]
  createdAt     DateTime                 @default(now())
}

model Player {
  id        String       @id @default(cuid())
  discordId String?      @unique
  gameUid   String       @unique
  ign       String
  members   TeamMember[]
  createdAt DateTime     @default(now())
}

enum MemberRole {
  OWNER
  PLAYER
  SUB
}

model TeamMember {
  id       String     @id @default(cuid())
  teamId   String
  team     Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId String
  player   Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  role     MemberRole
  joinedAt DateTime   @default(now())

  @@unique([teamId, playerId])
}

enum EventType {
  SCRIM
  TOURNAMENT
}

enum EventStatus {
  DRAFT
  OPEN
  LOCKED
  LIVE
  COMPLETED
  CANCELLED
}

model Tournament {
  id               String                   @id @default(cuid())
  name             String
  description      String?
  type             EventType
  format           String
  date             DateTime?
  maps             String[]
  teamLimit        Int
  region           String?
  teamSize         Int                      @default(4)
  tagsRequired     Int                      @default(4)
  status           EventStatus              @default(DRAFT)
  createdBy        String
  inviteUrl        String?
  announceChannelId String?
  announceMsgId    String?
  regStartsAt      DateTime?
  regChannelId     String?
  logChannelId     String?
  successRoleId    String?
  successMessage   String?
  pingRoleId       String?
  posterUrl        String?
  teamsPerGroup    Int?
  idpCategoryId    String?
  idpNamePattern   String?
  slotManagerChannelId String?
  slotManagerPanelMsgId String?
  idpGroups        IdpGroup[]
  registrations TournamentRegistration[]
  createdAt        DateTime                 @default(now())
}

enum RegStatus {
  PENDING
  APPROVED
  DISQUALIFIED
  REMOVED
}

model TournamentRegistration {
  id           String     @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  registeredBy String
  status       RegStatus  @default(PENDING)
  slotNo       Int
  groupNo      Int
  qualified    Boolean  @default(false)
  taggedDiscordIds String[] @default([])
  registeredAt DateTime   @default(now())

  @@unique([tournamentId, teamId])
  @@unique([tournamentId, slotNo])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  userId    String
  details   String?
  createdAt DateTime @default(now())
}

model GuildSettings {
  id           String   @id @default(cuid())
  guildId      String   @unique
  adminRoleIds String[]
  teamSize     Int      @default(4)
  maxSubs      Int      @default(2)
  teamIdPrefix String   @default("BR")
  maps         String[]
  groupSize    Int      @default(20)
  // Log channels per action (set via Admin Panel -> Logs)
  logTeamVerify    String?
  logTourneyReg    String?
  logScrimReg      String?
  logAdminActivity String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model IdpGroup {
  id          String     @id @default(cuid())
  tournamentId String
  tournament  Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  groupNo     Int
  channelId   String     @unique
  categoryId  String?
  panelMsgId  String?
  locked      Boolean    @default(true)
  matchesDate DateTime?
  totalMatches Int       @default(1)
  idpRoleHolderId String?
  roleId      String?
  matches     IdpMatch[]
  createdAt   DateTime   @default(now())

  @@unique([tournamentId, groupNo])
}

model IdpMatch {
  id        String   @id @default(cuid())
  idpGroupId String
  idpGroup  IdpGroup @relation(fields: [idpGroupId], references: [id], onDelete: Cascade)
  matchNo   Int
  map       String?
  idpAt     String?
  startAt   String?
  createdAt DateTime @default(now())

  @@unique([idpGroupId, matchNo])
}

// ============================================================================
// scrimport-1 — Black Raven scrims port (2026-09-30). Purely additive.
// teamId fields are plain Strings referencing Team.id — deliberately NO
// Prisma relation to Team so the Team model stays untouched.
// ============================================================================

model ScrimsVerification {
  id              String    @id @default(cuid())
  ownerDiscordId  String    @unique
  teamName        String
  ownerFullName   String?
  whatsappNumber  String?
  ownerEmail      String?
  city            String?
  playersJson     String    // JSON: [{number, ign, uid, discordId?}]
  messageId       String?
  status          String    @default("verified") // auto-approved like source
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model ScrimFormSession {  // DB-backed multi-step form state (replaces in-memory Maps)
  id            String   @id @default(cuid())
  userDiscordId String
  flowType      String   // e.g. "bs_verify", "bs_qualify"
  payload       String   @default("{}") // JSON
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  @@index([userDiscordId, flowType])
}

model ScrimGroup {
  id              String    @id @default(cuid())
  groupNo         Int
  groupType       String    // "OQ" | "T3"
  matchDate       DateTime?
  channelId       String    @unique
  roleId          String?
  categoryId      String?
  panelMsgId      String?
  createdBy       String
  status          String    @default("OPEN") // OPEN | CLOSED | DELETED
  isOpen          Boolean   @default(true)
  resultPublishedAt DateTime?
  cleanedAt       DateTime?
  slotListAutoPublishedAt DateTime?
  createdAt       DateTime  @default(now())
  matches         ScrimMatch[]
  slots           ScrimSlot[]
  @@unique([groupType, groupNo])
}

model ScrimMatch {
  id            String    @id @default(cuid())
  groupId       String
  group         ScrimGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  matchNo       Int
  map           String?
  idpAt         DateTime?
  startAt       DateTime?
  idpReminder30SentAt DateTime?
  idpReminder5SentAt  DateTime?
  createdAt     DateTime  @default(now())
  @@unique([groupId, matchNo])
}

model ScrimSlot {
  id        String  @id @default(cuid())
  groupId   String
  group     ScrimGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  slotNo    Int     // 5..25 (21 slots)
  teamId    String? // target Team.id (plain string, NO Prisma relation — do not touch Team model)
  status    String  @default("EMPTY") // EMPTY | FILLED | REMOVED
  createdAt DateTime @default(now())
  @@unique([groupId, slotNo])
}

model ScrimRegistration {
  id               String   @id @default(cuid())
  teamId           String   // target Team.id (plain string)
  groupId          String
  slotNo           Int
  registrationType String   // "OQ" | "T3"
  status           String   @default("ACTIVE") // ACTIVE | COMPLETED | CANCELLED | REMOVED
  registeredBy     String   // discord id
  createdAt        DateTime @default(now())
  @@index([teamId, status])
  @@index([groupId, status])
}

model ScrimsBan {
  id         String    @id @default(cuid())
  discordId  String
  teamId     String?
  reason     String?
  expiresAt  DateTime?
  bannedBy   String
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  @@index([discordId, active])
}

model SlotWarningCount {
  id        String   @id @default(cuid())
  teamId    String   @unique
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model SlotWarningLog {
  id             String   @id @default(cuid())
  teamId         String
  groupId        String?
  slotNo         Int?
  ownerDiscordId String?
  staffId        String?
  warningNo      Int
  reason         String?
  action         String?  // e.g. "WARNED", "AUTO_BANNED"
  createdAt      DateTime @default(now())
  @@index([teamId])
}

model SlotReminder {  // vacancy subscription: DM me when a slot frees in this group
  id            String   @id @default(cuid())
  userDiscordId String
  groupId       String
  notified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  @@unique([userDiscordId, groupId])
}

model ScrimConfirmationPost {
  id        String   @id @default(cuid())
  groupId   String
  teamId    String
  slotNo    Int
  serial    Int
  messageId String?
  createdAt DateTime @default(now())
  @@index([groupId])
}

model LiveLobbyPanel {
  id        String   @id @default(cuid())
  guildId   String
  channelId String
  messageId String?
  panelType String   // "OQ" | "T3" | "ALL"
  active    Boolean  @default(true)
  createdBy String
  createdAt DateTime @default(now())
}

model DeletedTeamBackup {  // JSON backup of a deleted scrims team, restorable
  id             String   @id @default(cuid())
  ownerDiscordId String
  teamName       String
  backupJson     String
  restored       Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model MessageTemplate {  // runtime-editable message templates (/message_template)
  name      String   @id
  content   String
  updatedAt DateTime @updatedAt
}
