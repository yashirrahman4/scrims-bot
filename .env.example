# Discord bot credentials (https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-client-id-here
GUILD_ID=your-discord-server-id-here

# PostgreSQL connection string
DATABASE_URL=postgresql://scrims:scrims@localhost:5432/scrimsbot?schema=public

# ---------- BR scrims port (SCRIMS_SETUP) ----------
# Everything degrades gracefully when unset; IDs are Discord channel/role IDs.
SCRIMS_VERIFY_CHANNEL_ID=
SCRIMS_VERIFIED_ROLE_ID=
SCRIMS_T3_ROLE_ID=
SCRIMS_OQ_CATEGORY_ID=
SCRIMS_T3_CATEGORY_ID=
SCRIMS_OQ_RESULTS_CHANNEL_ID=
SCRIMS_T3_RESULTS_CHANNEL_ID=
SCRIMS_OQ_WARN_CHANNEL_ID=
SCRIMS_T3_WARN_CHANNEL_ID=
SCRIMS_BAN_LOG_CHANNEL_ID=
SCRIMS_OQ_QUALIFIED_ROLE_ID=
SCRIMS_T3_QUALIFIED_ROLE_ID=
SCRIMS_SERVER_NAME=BLACK RAVEN ESPORTS
MAX_ACTIVE_OQ=2
MAX_ACTIVE_T3=2
SLOT_WASTE_MAX_WARNINGS=3
SLOT_WASTE_BAN_DAYS=30
SS_IDP_DUP_MINUTES=30
